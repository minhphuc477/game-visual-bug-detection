      "name": "User Interface (UI) & HUD Anomalies",
      "subtypes": [
        { "code": "UI-01", "name": "UI Element Collision / Overlap", "temporal": false, "subtle": false },
        { "code": "UI-02", "name": "Text Truncation / Overflow", "temporal": false, "subtle": true },
        { "code": "UI-03", "name": "Aspect Ratio / Resolution Stretch", "temporal": false, "subtle": true },
        { "code": "UI-04", "name": "Persistent Zombie Modal Occlusion", "temporal": true, "subtle": false }
      ]
    }
